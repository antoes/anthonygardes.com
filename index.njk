---
layout: /layouts/baseLayout.njk
description: "Anthony Gardes — hands-on Azure labs, cloud projects, and creative work. Step-by-step guides for VM deployment, VPNs, static web apps, and more."
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Anthony Gardes",
  "url": "https://www.anthonygardes.com",
  "image": "https://www.anthonygardes.com/public/img/anthonyCard.webp",
  "sameAs": ["https://www.linkedin.com/in/anthonygardes"],
  "description": "Personal site of Anthony Gardés — labs, projects, and creative work at the intersection of tech and creativity."
}
</script>
<div class="wa-stack wa-gap-m">
    <div class="wa-stack">
        <div class="wa-grid wa-gap-2xl">
          <div class="wa-stack">
               <h1>👋 I'm Anthony, explorer of all things creative and tech.</h1>
                <p>Feel free to reach me anytime with questions, comments or projects you'd like to see 🙌</p>
                <div class="wa-cluster wa-gap-xs">
                  <wa-button appearance="plain" href="/contact/" variant="neutral" size="medium">Send me a message <wa-icon slot="end" name="arrow-right" aria-hidden="true" library="default"></wa-icon></wa-button>
                </div>
            </div>
            <div class="wa-frame wa-border-radius-l" style="aspect-ratio: 1/1;">
                <img
                src="/public/img/anthonyCard.webp"
                alt="Portrait of Anthony Gardés infront of a colorful wall"
                loading="eager"
                fetchpriority="high"
                />
            </div>
        </div>
    </div>
</div>

<div style="margin-top: 4rem;">
    <h2>Recent Posts</h2>
    {% set postLimit = 3 %}
    {% include "postslist.njk" %}
    <div style="margin-top: 1.5rem; text-align: center;">
        <wa-button href="/posts" variant="brand" appearance="filled-outlined">View all posts <wa-icon slot="end" name="arrow-right" aria-hidden="true"></wa-icon></wa-button>
    </div>
</div>
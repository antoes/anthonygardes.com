---
layout: /layouts/baseLayout.njk
pageType: tag
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag | slugify }}/
---

<h1 data-pagefind-meta=”title”>{{ tag }}</h1>
<div class="wa-stack wa-gap-s">
{% set taglist = collections[ tag ] %}
{% for post in taglist | reverse %}
	<wa-card orientation="horizontal" class="horizontal-card">
		<h4><a href="{{ post.url }}">{{ post.data.title }}</a></h4>
		{% if post.data.description %}<p class="wa-caption-m" style="margin:0.25rem 0 0;">{{ post.data.description }}</p>{% endif %}
	</wa-card>
{% endfor %}
</div>
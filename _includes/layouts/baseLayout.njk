<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta property="og:title" content="Anthony Gardes: Tech x Creative"/>
    <meta property="og:image" content="./public/img/anthonyCard.webp"/>
    <meta property="og:description" content="Labs, Projects, and Creative Work by Anthony Gardes"/>
    <meta property="og:url" content="www.anthonygardes.com"/>
    <script src="https://kit.webawesome.com/2b5f5fbfa4b141d0.js" crossorigin="anonymous" defer></script>
    <style>
      a:hover { color: #FF8B57; }
      wa-page::part(navigation-toggle) { display: none; }
      wa-page::part(navigation) { display: none; }
      .nav-mobile { display: none; }
      @media (max-width: 640px) {
        .nav-desktop { display: none; }
        .nav-mobile { display: flex; }
      }
    </style>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em'
        font-size='100'>🤖</text></svg>"/>
    <title>Anthony Gardes</title>
  </head>
  <body>
    <wa-page>
      <header slot="header" style="display: flex; justify-content: center; width: 100%;">
        <!-- Desktop nav -->
        <div class="nav-desktop wa-cluster wa-gap-l">
          <wa-button appearance="plain" href="/">Home</wa-button>
          <wa-button appearance="plain" href="/contact">Contact</wa-button>
          <wa-button appearance="plain" href="/posts">Posts</wa-button>
          <wa-button appearance="plain" id="searchBtn" aria-label="Search">
            <wa-icon name="magnifying-glass" label="Search"></wa-icon>
          </wa-button>
        </div>
        <!-- Mobile nav -->
        <div class="nav-mobile wa-split" style="width: 100%; padding: 0 var(--wa-space-m); align-items: center;">
          <wa-button appearance="plain" data-drawer="open mobileNav" aria-label="Open menu">
            <wa-icon name="bars" label="Menu"></wa-icon>
          </wa-button>
          <wa-button appearance="plain" id="searchBtnMobile" aria-label="Search">
            <wa-icon name="magnifying-glass" label="Search"></wa-icon>
          </wa-button>
        </div>
      </header>
      <main id="content" data-pagefind-body style="max-width: 90ch; margin: 0 auto;">
        {{content | safe}}
      </main>
      <footer slot="footer" id="footer" style="max-width: 90ch; margin: 0 auto; display: flex; justify-content: center;">
        <div class="wa-cluster wa-gap-s">
          <wa-button
            href="https://www.linkedin.com/in/anthonygardes"
            target="_blank"
            rel="noopener"
            appearance="plain"
            size="large">
            <wa-icon name="linkedin" family="brands" label="linkedin"></wa-icon>
          </wa-button>
        </div>
        <div class="wa-split">
          <p>Built by Anthony Gardés w/
            <a href="https://www.11ty.dev/" target="_blank" rel="noopener">11ty</a>,
            <a href="https://webawesome.com/" target="_blank" rel="noopener">Webawesome</a>, and
            <a href="https://azure.microsoft.com/en-us" target="_blank" rel="noopener">Microsoft Azure</a>.</p>
          <p>© 2026 All rights reserved.</p>
        </div>
      </footer>
    </wa-page>

    <wa-drawer id="mobileNav" placement="start" label="Menu" data-pagefind-ignore>
      <nav class="wa-stack wa-gap-xs">
        <wa-button appearance="plain" href="/" size="large">Home</wa-button>
        <wa-divider></wa-divider>
        <wa-button appearance="plain" href="/posts" size="large">Posts</wa-button>
        <wa-divider></wa-divider>
        <wa-button appearance="plain" href="/contact" size="large">Contact</wa-button>
      </nav>
    </wa-drawer>

    <wa-dialog label="Search" id="searchDialog" style="--width: 600px;" data-pagefind-ignore>
      <wa-input id="searchInput" placeholder="Search posts…" size="large" clearable autocomplete="off">
        <wa-icon slot="prefix" name="magnifying-glass"></wa-icon>
      </wa-input>
      <div id="searchResults" class="wa-stack wa-gap-s" style="margin-top: 1rem;"></div>
    </wa-dialog>

    <script>
      const searchBtn = document.getElementById('searchBtn');
      const searchDialog = document.getElementById('searchDialog');
      const searchInput = document.getElementById('searchInput');
      const searchResults = document.getElementById('searchResults');
      let pagefind;

      async function openSearch() {
        searchDialog.show();
        if (!pagefind) {
          try {
            pagefind = await import('/pagefind/pagefind.js');
          } catch {
            searchResults.innerHTML = '<p class="wa-caption-m">Search index not found — run <code>npm run build</code> first.</p>';
            return;
          }
        }
        searchInput.focus();
      }

      searchBtn.addEventListener('click', openSearch);
      document.getElementById('searchBtnMobile').addEventListener('click', openSearch);

      // Cmd+K / Ctrl+K shortcut
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          openSearch();
        }
      });

      // Clear results when dialog closes so it opens fresh next time
      searchDialog.addEventListener('wa-after-hide', () => {
        searchInput.value = '';
        searchResults.innerHTML = '';
      });

      let debounce;
      searchInput.addEventListener('input', (e) => {
        clearTimeout(debounce);
        debounce = setTimeout(async () => {
          const query = e.target.value.trim();
          if (!query) { searchResults.innerHTML = ''; return; }

          const search = await pagefind.search(query);
          if (!search.results.length) {
            searchResults.innerHTML = '<p class="wa-caption-m">No results found.</p>';
            return;
          }

          const data = await Promise.all(search.results.slice(0, 8).map(r => r.data()));
          searchResults.innerHTML = data.map(r => `
            <a href="${r.url}" style="text-decoration: none; display: block;">
              <wa-card>
                <strong>${r.meta.title || 'Untitled'}</strong>
                <p class="wa-caption-m" style="margin: 0.25rem 0 0;">${r.excerpt}</p>
              </wa-card>
            </a>
          `).join('');
        }, 250);
      });
    </script>
  </body>
</html>